@{
    ViewData["Title"] = "Đăng nhập";
}
@section Styles {
    <link rel="stylesheet" href="~/css/DangNhap.css" asp-append-version="true" />
}

<div class="container mt-5" style="max-width: 420px;">
    <h2 class="mb-4 text-center login-title">ĐĂNG NHẬP</h2>
    <p class="text-center mb-4 login-subtext">Vui lòng nhập tên đăng nhập và mật khẩu của bạn:</p>

    <form method="post" asp-controller="TaiKhoan" asp-action="DangNhap" novalidate>
        <div class="mb-3">
            <label for="tenDangNhap" class="form-label visually-hidden">Tên đăng nhập</label>
            <input type="text" class="form-control custom-input" id="tenDangNhap" name="tenDangNhap" placeholder="Tên đăng nhập" required />
        </div>
        <div class="mb-3">
            <label for="matKhau" class="form-label visually-hidden">Mật khẩu</label>
            <input type="password" class="form-control custom-input" id="matKhau" name="matKhau" placeholder="Mật khẩu" required />
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger" role="alert">@ViewBag.ThongBao</div>
        }

        <button type="submit" class="btn btn-warning w-100 login-button">ĐĂNG NHẬP</button>
    </form>

    <p class="mt-3 text-center dont-have-account">
        Chưa có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangKy" class="create-one-link">Đăng ký ngay</a>
    </p>
</div>
