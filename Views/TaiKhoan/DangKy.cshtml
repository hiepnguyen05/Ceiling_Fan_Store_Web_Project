@{
    ViewData["Title"] = "Đăng ký";
}
@section Styles {
    <link rel="stylesheet" href="~/css/DangNhap.css" asp-append-version="true" />
}

<div class="container mt-5" style="max-width: 420px;">
    <h2 class="mb-4 text-center register-title">ĐĂNG KÝ</h2>
    <p class="text-center mb-4 register-subtext">Tạo tài khoản mới của bạn:</p>

    <form method="post" asp-controller="TaiKhoan" asp-action="DangKy" novalidate>
        <div class="mb-3">
            <label for="tenDangNhap" class="form-label visually-hidden">Tên đăng nhập</label>
            <input type="text" class="form-control custom-input" id="tenDangNhap" name="tenDangNhap" placeholder="Tên đăng nhập" required />
        </div>
        <div class="mb-3">
            <label for="email" class="form-label visually-hidden">Email</label>
            <input type="email" class="form-control custom-input" id="email" name="email" placeholder="Email" required />
        </div>
        <div class="mb-3">
            <label for="matKhau" class="form-label visually-hidden">Mật khẩu</label>
            <input type="password" class="form-control custom-input" id="matKhau" name="matKhau" placeholder="Mật khẩu" required />
        </div>
        <div class="mb-3">
            <label for="matKhauXacNhan" class="form-label visually-hidden">Xác nhận mật khẩu</label>
            <input type="password" class="form-control custom-input" id="matKhauXacNhan" name="matKhauXacNhan" placeholder="Xác nhận mật khẩu" required />
        </div>

        @if (ViewBag.ThongBao != null)
        {
            <div class="alert alert-danger" role="alert">@ViewBag.ThongBao</div>
        }

        <button type="submit" class="btn btn-warning w-100 register-button">ĐĂNG KÝ</button>
    </form>

    <p class="mt-3 text-center already-have-account">
        Đã có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangNhap" class="login-link">Đăng nhập</a>
    </p>
</div>