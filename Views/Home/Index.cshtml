@model List<NgocHiepCeilingFans.Models.SanPham>

@{
    ViewData["Title"] = "Trang Chủ";
}

<style>
    .featured-title {
        text-align: center;
        font-size: 2rem;
        margin: 30px 0;
        padding-top: 20px;
    }
</style>

<div class="full-width-carousel">
    <div id="bannerSlider" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/Bnaner/banner6.webp" alt="Banner 1">
                <div class="carousel-caption">
                    <p>QUẠT TRẦN THÔNG MINH WIFI</p>
                    <h3>QUẠT TRẦN HIỆN ĐẠI</h3>
                    <a href="#" class="btn">BỘ SƯU TẬP</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/Bnaner/Banner1.webp" alt="Banner 2">
                <div class="carousel-caption">
                    <p>THIẾT KẾ SANG TRỌNG</p>
                    <h3>QUẠT TRẦN CAO CẤP</h3>
                    <a href="#" class="btn">BỘ SƯU TẬP</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="~/images/Bnaner/Banner3.webp" alt="Banner 3">
                <div class="carousel-caption">
                    <p>TIẾT KIỆM ĐIỆN NĂNG</p>
                    <h3>QUẠT TRẦN TIẾT KIỆM</h3>
                    <a href="#" class="btn">BỘ SƯU TẬP</a>
                </div>
            </div>
            <div class="carousel-item">
                <img src="https://ceilingfanshoppe.com/cdn/shop/files/Untitled_design_2_2000x.png?v=1724697318" alt="Banner 4">
                <div class="carousel-caption">
                    <p>ĐỘNG CƠ MẠNH MẼ</p>
                    <h3>QUẠT TRẦN CÔNG SUẤT LỚN</h3>
                    <a href="#" class="btn">BỘ SƯU TẬP</a>
                </div>
            </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#bannerSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#bannerSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>

        <div class="carousel-indicators">
            <button type="button" data-bs-target="#bannerSlider" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#bannerSlider" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#bannerSlider" data-bs-slide-to="2" aria-label="Slide 3"></button>
            <button type="button" data-bs-target="#bannerSlider" data-bs-slide-to="3" aria-label="Slide 4"></button>
        </div>
    </div>
</div>

<p class="featured-title">Sản phẩm nổi bật</p>

<div class="row">
    @if (!Model.Any())
    {
        <p class="text-center">Không tìm thấy sản phẩm nào.</p>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 col-12 mb-4">
                <div class="product-card p-3 rounded shadow-sm d-flex flex-column">
                    <a asp-controller="SanPhams" asp-action="ChiTiet" asp-route-id="@item.MaSanPham" class="product-display-area d-block text-decoration-none text-dark flex-grow-1">
                        <div class="product-image-wrapper mb-3">
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="@Url.Content(item.HinhAnh)" alt="@item.TenSanPham" class="img-fluid" loading="lazy" />
                            }
                            else
                            {
                                <img src="@Url.Content("/images/noimage.png")" alt="Không có ảnh" class="img-fluid" loading="lazy" />
                            }
                        </div>
                        <div class="product-info w-100">
                            <div class="product-name">
                                @Html.DisplayFor(modelItem => item.TenSanPham)
                            </div>
                            <div class="product-price mt-auto pt-2 border-top border-light">
                                @if (item.Gia > 0 && item.Gia < 100000000)
                                {
                                    <span class="old-price">@((item.Gia * 1.2M).ToString("N0")) VND</span>
                                }
                                @item.Gia.ToString("N0") VND
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        }
    }
</div>


<div class="text-center mt-4">
    <a href="@Url.Action("DanhSach", "SanPhams")" class="btn btn-primary">Xem tất cả sản phẩm</a>
</div>
<hr />
<div class="collection-section">
    <p class="featured-title">Bộ sưu tập</p>
    <div class="collection-row">
        <div class="collection-item" style="background-image: url('@Url.Content("~/images/sanpham/quatHienDai1.webp")');">
            <div class="collection-content">
                <p>Quạt Hiện Đại</p>
                <p class="description">Khám phá thiết kế tinh tế và công nghệ tiên tiến.</p>
                <a href="http://localhost:5161/SanPhams/TheoPhongCach?loaiQuat=Qu%E1%BA%A1t%20tr%E1%BA%A7n%20hi%E1%BB%87n%20%C4%91%E1%BA%A1i" class="btn">Xem bộ sưu tập</a>
            </div>
        </div>
        <div class="collection-item" style="background-image: url('@Url.Content("~/images/sanpham/QuatCaoCap.webp")');">
            <div class="collection-content">
                <p>Quạt Cao Cấp</p>
                <p class="description">Sự kết hợp hoàn hảo giữa sang trọng và hiệu suất.</p>
                <a href="http://localhost:5161/SanPhams/TheoPhongCach?loaiQuat=Qu%E1%BA%A1t%20tr%E1%BA%A7n%20%E1%BA%A9n%20(gi%E1%BA%A5u%20c%C3%A1nh)" class="btn">Xem bộ sưu tập</a>
            </div>
        </div>
        <div class="collection-item" style="background-image: url('@Url.Content("~/images/sanpham/QuatTietKiem.jpg")');">
            <div class="collection-content">
                <p>Quạt Tiết Kiệm</p>
                <p class="description">Thiết kế tối ưu cho không gian tiết kiệm năng lượng.</p>
                <a href="http://localhost:5161/SanPhams/TheoPhongCach?loaiQuat=Qu%E1%BA%A1t%20tr%E1%BA%A7n%20c%C3%B4ng%20ngh%E1%BB%87%20th%C3%B4ng%20minh" class="btn">Xem bộ sưu tập</a>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="about-us-section">

    <p  class="featured-title">Giới thiệu về chúng tôi</p>
	<p>
		Ngọc Hiệp Ceiling Fans chuyên cung cấp các sản phẩm quạt trần chất lượng cao với thiết kế hiện đại, tiết kiệm điện năng và thân thiện với môi trường. Chúng tôi cam kết mang đến cho khách hàng những sản phẩm tốt nhất với dịch vụ tận tâm.

	</p>
	<p>
		Tại Ngọc Hiệp, chúng tôi hiểu rằng quạt trần không chỉ là một thiết bị làm mát mà còn là một phần quan trọng trong trang trí nội thất. Với đội ngũ thiết kế chuyên nghiệp và công nghệ sản xuất tiên tiến, chúng tôi mang đến những sản phẩm không chỉ đẹp mắt mà còn hiệu quả trong việc tiết kiệm năng lượng.
	</p>
	<p>
		Chúng tôi luôn nỗ lực không ngừng để cải tiến sản phẩm và dịch vụ, nhằm đáp ứng nhu cầu ngày càng cao của khách hàng. Với Ngọc Hiệp, bạn sẽ tìm thấy những sản phẩm quạt trần hoàn hảo cho không gian sống của mình.
	</p>



</div>

 <hr />
