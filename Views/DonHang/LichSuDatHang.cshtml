@model List<NgocHiepCeilingFans.Models.DonHang>

@{
    ViewData["Title"] = "Lịch Sử Đặt Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    body {
        margin-top: 130px;
    }

    h2 {
        color: #333;
        font-weight: 300;
    }

    .btn-outline-custom {
        background-color: transparent;
        border: 1px solid #333;
        color: #333;
        font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        border-radius: 4px;
        transition: all 0.2s ease-in-out;
    }

        .btn-outline-custom:hover {
            background-color: rgba(0, 0, 0, 0.05);
            color: #000;
            border-color: #000;
            text-decoration: underline;
            cursor: pointer;
        }


  
</style>

<h2>Lịch Sử Đặt Hàng</h2>

@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã Đơn Hàng</th>
                <th>Ngày Đặt</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donHang in Model)
            {
                <tr>
                    <td>@donHang.Id</td>
                    <td>@donHang.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@donHang.TongTien.ToString("N0") VNĐ</td>
                    <td>@donHang.TrangThai</td>
                    <td>
                        <a asp-action="ChiTietDonHang" asp-route-id="@donHang.Id" class="btn btn-sm btn-outline-custom">
                            Xem Chi Tiết
                        </a>

                        @if (donHang.TrangThai == "Chờ Xử Lý")
                        {
                            <form asp-action="HuyDonHang" method="post" style="display:inline-block;">
                                <input type="hidden" name="id" value="@donHang.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-outline-custom"
                                        onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này không?');">
                                    Hủy Đơn
                                </button>
                            </form>
                        }

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Bạn chưa có đơn hàng nào.</p>
}