@model IEnumerable<NgocHiepCeilingFans.Models.SanPham>

@{
    ViewData["Title"] = "Danh Sách Sản Phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var currentSearchString = ViewBag.CurrentSearchString as string;
    var currentThuongHieuFilter = ViewBag.CurrentThuongHieuFilter as string[] ?? Array.Empty<string>();
    var currentLoaiQuatFilter = ViewBag.CurrentLoaiQuatFilter as string[] ?? Array.Empty<string>();
    var currentGiaFilter = ViewBag.CurrentGiaFilter as string[] ?? Array.Empty<string>();
    var currentSoCanhFilter = ViewBag.CurrentSoCanhFilter as int?[] ?? Array.Empty<int?>();
    var currentSortBy = ViewBag.CurrentSortBy as string;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int pageSize = ViewBag.PageSize ?? 12;
}

<h1 class="text-center my-4">Danh Sách Sản Phẩm</h1>

<div class="container-fluid main-content-area">
    <div class="row">
        <div class="col-lg-3 col-md-4">
            <form id="filterForm" asp-action="DanhSach" method="get">
                <input type="hidden" name="sortBy" value="@currentSortBy" />
                <input type="hidden" name="pageNumber" id="pageNumber" value="@currentPage" />
                <input type="hidden" name="pageSize" value="@pageSize" />
                @foreach (var thuongHieu in currentThuongHieuFilter)
                {
                    <input type="hidden" name="thuongHieuFilter" value="@thuongHieu" class="hidden-filter thuongHieuFilter" />
                }
                @foreach (var loaiQuat in currentLoaiQuatFilter)
                {
                    <input type="hidden" name="loaiQuatFilter" value="@loaiQuat" class="hidden-filter loaiQuatFilter" />
                }
                @foreach (var gia in currentGiaFilter)
                {
                    <input type="hidden" name="giaFilter" value="@gia" class="hidden-filter giaFilter" />
                }
                @foreach (var soCanh in currentSoCanhFilter.Where(c => c.HasValue))
                {
                    <input type="hidden" name="soCanhFilter" value="@soCanh" class="hidden-filter soCanhFilter" />
                }

                <div class="sidebar mb-4">
                    <div class="filter-group">
                        <div class="filter-group-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapseLoaiSanPham" aria-expanded="true" aria-controls="collapseLoaiSanPham">
                            Loại sản phẩm <span class="toggle-icon">▼</span>
                        </div>
                        <div class="collapse show filter-options" id="collapseLoaiSanPham">
                            @foreach (var loai in ViewBag.LoaiQuatList as SelectList)
                            {
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" name="loaiQuatFilter" value="@loai.Text" id="filterLoaiQuat_@loai.Text.Replace(" ", "").Replace("/", "")" @(currentLoaiQuatFilter.Contains(loai.Text) ? "checked" : "")>
                                    <label class="form-check-label" for="filterLoaiQuat_@loai.Text.Replace(" ", "").Replace("/", "")">
                                        @loai.Text
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapseThuongHieu" aria-expanded="true" aria-controls="collapseThuongHieu">
                            Thương hiệu <span class="toggle-icon">▼</span>
                        </div>
                        <div class="collapse show filter-options" id="collapseThuongHieu">
                            @foreach (var thuongHieu in ViewBag.ThuongHieuList as SelectList)
                            {
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" name="thuongHieuFilter" value="@thuongHieu.Text" id="filterThuongHieu_@thuongHieu.Text.Replace(" ", "").Replace("/", "")" @(currentThuongHieuFilter.Contains(thuongHieu.Text) ? "checked" : "")>
                                    <label class="form-check-label" for="filterThuongHieu_@thuongHieu.Text.Replace(" ", "").Replace("/", "")">
                                        @thuongHieu.Text
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapseGia" aria-expanded="true" aria-controls="collapseGia">
                            Giá <span class="toggle-icon">▼</span>
                        </div>
                        <div class="collapse show filter-options" id="collapseGia">
                            @{
                                var priceRanges = new Dictionary<string, string>
                            {
                            { "0-1000000", "Dưới 1.000.000 VND" },
                            { "1000001-3000000", "1.000.000 - 3.000.000 VND" },
                            { "3000001-5000000", "3.000.001 - 5.000.000 VND" },
                            { "5000001-", "Trên 5.000.000 VND" }
                            };
                            }
                            @foreach (var range in priceRanges)
                            {
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" name="giaFilter" value="@range.Key" id="filterGia_@range.Key.Replace("-", "_").Replace(".", "")" @(currentGiaFilter.Contains(range.Key) ? "checked" : "")>
                                    <label class="form-check-label" for="filterGia_@range.Key.Replace("-", "_").Replace(".", "")">
                                        @range.Value
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="filter-group">
                        <div class="filter-group-header d-flex justify-content-between align-items-center" data-bs-toggle="collapse" data-bs-target="#collapseSoCanh" aria-expanded="true" aria-controls="collapseSoCanh">
                            Số cánh <span class="toggle-icon">▼</span>
                        </div>
                        <div class="collapse show filter-options" id="collapseSoCanh">
                            @foreach (var soCanh in ViewBag.SoCanhList as SelectList)
                            {
                                <div class="form-check">
                                    <input class="form-check-input filter-checkbox" type="checkbox" name="soCanhFilter" value="@soCanh.Text" id="filterSoCanh_@soCanh.Text" @(currentSoCanhFilter.Contains(int.Parse(soCanh.Text)) ? "checked" : "")>
                                    <label class="form-check-label" for="filterSoCanh_@soCanh.Text">
                                        @soCanh.Text
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="col-lg-9 col-md-8">
            <div class="product-listing-header d-flex justify-content-between align-items-center mb-4 p-3 border rounded">
                <div class="search-input-wrapper flex-grow-1 me-3">
                    <input type="text" class="form-control" placeholder="Tìm kiếm sản phẩm" name="searchString" form="filterForm" value="@currentSearchString">
                </div>
                <div class="product-count-info text-nowrap">
                    <span class="fw-bold">@ViewBag.TotalItems</span> Sản phẩm
                </div>
            </div>

            <div class="row">
                @if (!Model.Any())
                {
                    <p class="text-center">Không tìm thấy sản phẩm nào.</p>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="col-lg-4 col-md-6 col-sm-6 col-12 mb-4">
                            <div class="product-card p-3 rounded shadow-sm d-flex flex-column">
                                <a asp-action="ChiTiet" asp-route-id="@item.MaSanPham" class="product-display-area d-block text-decoration-none text-dark flex-grow-1">
                                    <div class="product-image-wrapper mb-3">
                                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                                        {
                                            <img src="@Url.Content(item.HinhAnh)" alt="@item.TenSanPham" class="img-fluid" loading="lazy" />
                                        }
                                        else
                                        {
                                            <img src="@Url.Content("/images/noimage.png")" alt="Không có ảnh" class="img-fluid" loading="lazy" />
                                        }
                                    </div>
                                    <div class="product-info w-100">
                                        <div class="product-name">
                                            @Html.DisplayFor(modelItem => item.TenSanPham)
                                        </div>
                                        <div class="product-price mt-auto pt-2 border-top border-light">
                                            @if (item.Gia > 0 && item.Gia < 100000000)
                                            {
                                                <span class="old-price">@((item.Gia * 1.2M).ToString("N0")) VND</span>
                                            }
                                            @item.Gia.ToString("N0") VND
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("DanhSach", new
                            {
                                searchString = currentSearchString,
                                thuongHieuFilter = currentThuongHieuFilter,
                                loaiQuatFilter = currentLoaiQuatFilter,
                                giaFilter = currentGiaFilter,
                                soCanhFilter = currentSoCanhFilter,
                                sortBy = currentSortBy,
                                pageNumber = currentPage - 1,
                                pageSize
                            })"> <i class="bi bi-chevron-left"></i> </a>
                        </li>

                        @{
                            var startPage = Math.Max(1, currentPage - 2);
                            var endPage = Math.Min(totalPages, currentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li class="page-item @(1 == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DanhSach", new { searchString = currentSearchString, thuongHieuFilter = currentThuongHieuFilter, loaiQuatFilter = currentLoaiQuatFilter, giaFilter = currentGiaFilter, soCanhFilter = currentSoCanhFilter, sortBy = currentSortBy, pageNumber = 1, pageSize })">1</a>
                            </li>
                        }

                        @if (startPage > 2)
                        {
                            <li class="page-item ellipsis">
                                <span class="page-link">...</span>
                            </li>
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            @if (i == 1 && startPage > 1) { continue; }
                            @if (i == totalPages && endPage < totalPages) { continue; }

                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DanhSach", new
                                {
                                    searchString = currentSearchString,
                                    thuongHieuFilter = currentThuongHieuFilter,
                                    loaiQuatFilter = currentLoaiQuatFilter,
                                    giaFilter = currentGiaFilter,
                                    soCanhFilter = currentSoCanhFilter,
                                    sortBy = currentSortBy,
                                    pageNumber = i,
                                    pageSize
                                })">@i</a>
                            </li>
                        }

                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item ellipsis">
                                <span class="page-link">...</span>
                            </li>
                        }

                        @if (endPage < totalPages)
                        {
                            <li class="page-item @(totalPages == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("DanhSach", new { searchString = currentSearchString, thuongHieuFilter = currentThuongHieuFilter, loaiQuatFilter = currentLoaiQuatFilter, giaFilter = currentGiaFilter, soCanhFilter = currentSoCanhFilter, sortBy = currentSortBy, pageNumber = totalPages, pageSize })">@totalPages</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("DanhSach", new
                            {
                                searchString = currentSearchString,
                                thuongHieuFilter = currentThuongHieuFilter,
                                loaiQuatFilter = currentLoaiQuatFilter,
                                giaFilter = currentGiaFilter,
                                soCanhFilter = currentSoCanhFilter,
                                sortBy = currentSortBy,
                                pageNumber = currentPage + 1,
                                pageSize
                            })"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const filterForm = document.getElementById('filterForm');
            const filterCheckboxes = document.querySelectorAll('.filter-checkbox');
            const searchInput = document.querySelector('input[name="searchString"]');
            const filterGroupHeaders = document.querySelectorAll('.filter-group-header');

            // Xử lý thay đổi checkbox
            filterCheckboxes.forEach(function(checkbox) {
                checkbox.addEventListener('change', function() {
                    // Xóa tất cả input ẩn của bộ lọc
                    document.querySelectorAll('.hidden-filter').forEach(input => input.remove());

                    // Thêm input ẩn cho các checkbox đang được chọn
                    const checkedThuongHieu = Array.from(document.querySelectorAll('input[name=thuongHieuFilter]:checked'));
                    const checkedLoaiQuat = Array.from(document.querySelectorAll('input[name=loaiQuatFilter]:checked'));
                    const checkedGia = Array.from(document.querySelectorAll('input[name=giaFilter]:checked'));
                    const checkedSoCanh = Array.from(document.querySelectorAll('input[name=soCanhFilter]:checked'));

                    checkedThuongHieu.forEach(cb => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'thuongHieuFilter';
                        input.value = cb.value;
                        input.className = 'hidden-filter thuongHieuFilter';
                        filterForm.appendChild(input);
                    });

                    checkedLoaiQuat.forEach(cb => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'loaiQuatFilter';
                        input.value = cb.value;
                        input.className = 'hidden-filter loaiQuatFilter';
                        filterForm.appendChild(input);
                    });

                    checkedGia.forEach(cb => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'giaFilter';
                        input.value = cb.value;
                        input.className = 'hidden-filter giaFilter';
                        filterForm.appendChild(input);
                    });

                    checkedSoCanh.forEach(cb => {
                        const input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'soCanhFilter';
                        input.value = cb.value;
                        input.className = 'hidden-filter soCanhFilter';
                        filterForm.appendChild(input);
                    });

                    // Reset pageNumber về 1
                    document.getElementById('pageNumber').value = 1;
                    filterForm.submit();
                });
            });

            // Reset pageNumber về 1 khi tìm kiếm
            if (searchInput) {
                searchInput.addEventListener('keypress', function(event) {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        document.getElementById('pageNumber').value = 1;
                        filterForm.submit();
                    }
                });
            }

            // Toggle icon rotation cho Bootstrap collapse
            filterGroupHeaders.forEach(function(header) {
                const toggleIcon = header.querySelector('.toggle-icon');
                if (toggleIcon && header.getAttribute('aria-expanded') === 'true') {
                    toggleIcon.classList.add('rotate');
                }

                header.addEventListener('click', function() {
                    setTimeout(() => {
                        if (header.getAttribute('aria-expanded') === 'true') {
                            toggleIcon.classList.add('rotate');
                        } else {
                            toggleIcon.classList.remove('rotate');
                        }
                    }, 50);
                });
            });
        });
    </script>
}