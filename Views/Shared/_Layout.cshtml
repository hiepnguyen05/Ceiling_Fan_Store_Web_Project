<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NgocHiepCeilingFans</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NgocHiepCeilingFans.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-tai-khoan.css" />
    <link rel="stylesheet" href="~/css/san-pham.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chi-tiet.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/MuaTheo.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class ="fixed-top" style="z-index: 1030;">
        <nav class="navbar navbar-expand-lg navbar-light bg-white mb-0 position-relative **fixed-top**" style="z-index: 1030;">
            <div class="container-fluid position-relative">
                <a class="navbar-brand position-absolute top-50 start-50 translate-middle text-center py-3"
                   asp-area="" asp-controller="Home" asp-action="Index"
                   style="z-index: 10;">
                    <img src="~/images/logo/Logo3.png" alt="NgocHiep Logo" class="img-fluid" style="max-height: 70px; object-fit: contain;">
                </a>

                <div class="d-flex align-items-center me-auto"></div>

                <div class="d-flex ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <div class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" id="navbarDropdownAccount" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person"></i> Xin chào @User.Identity.Name!
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdownAccount">
                                <li><a class="dropdown-item" asp-area="" asp-controller="DonHang" asp-action="LichSuDatHang">Đơn hàng của bạn</a></li>
                                <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="TaiKhoan" asp-action="DangXuat">Đăng xuất</a>
                                    </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="nav-link text-dark" asp-area="" asp-controller="TaiKhoan" asp-action="DangNhap">
                            <i class="bi bi-person"></i> Tài khoản
                        </a>
                    }
                    <a class="nav-link text-dark" asp-area="" asp-controller="GioHang" asp-action="Index">
                        <i class="bi bi-cart"></i> Giỏ hàng
                    </a>
                </div>
            </div>
        </nav>

        <nav class="navbar navbar-expand-lg navbar-light bg-white **fixed-top**" style="z-index: 1029; **top: 90px;**">
            <div class="container justify-content-center">
                <ul class="navbar-nav text-center">
                    <li class="nav-item px-3">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link text-dark" asp-controller="SanPhams" asp-action="DanhSach">Sản phẩm của chúng tôi</a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link text-dark" asp-controller="SanPhams" asp-action="TheoPhongCach">Mua sắm theo phong cách</a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link text-dark" asp-controller="SanPhams" asp-action="TheoThuongHieu">Mua sắm theo thương hiệu</a>
                    </li>
                    <li class="nav-item px-3">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="LienHe">Liên hệ với chúng tôi</a>
                    </li>
                </ul>
            </div>
        </nav>
       
        <hr class="m-0" style="border-top: 1px solid #ccc;">
      </nav>



    </header>
    <div class="container">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show mt-3" role="alert">
                @TempData["ThongBao"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer style="background-color: #f8f8f8; padding: 20px 0; border-top: 1px solid #ddd; color: #333; font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;">
        <div style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; flex-wrap: wrap; padding: 0 15px;">
            <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
                <h4 style="font-weight: 300; margin-bottom: 10px;">Liên Hệ</h4>
                <p style="margin: 5px 0;">Email: support@ngochiepceilingfans.com</p>
                <p style="margin: 5px 0;">Điện thoại: 0909 123 456</p>
                <p style="margin: 5px 0;">Địa chỉ: Đại Lai - Gia Bình - Bắc Ninh</p>
            </div>
            <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
                <h4 style="font-weight: 300; margin-bottom: 10px;">Liên Kết Nhanh</h4>
                <ul style="list-style: none; padding: 0;">
                    <li style="margin: 5px 0;"><a href="@Url.Action("Index", "Home")" style="color: #333; text-decoration: none;">Trang Chủ</a></li>
                    <li style="margin: 5px 0;"><a href="@Url.Action("Index", "SanPham")" style="color: #333; text-decoration: none;">Sản Phẩm</a></li>
                    <li style="margin: 5px 0;"><a href="@Url.Action("Index", "GioHang")" style="color: #333; text-decoration: none;">Giỏ Hàng</a></li>
                    <li style="margin: 5px 0;"><a href="@Url.Action("Index", "LienHe")" style="color: #333; text-decoration: none;">Liên Hệ</a></li>
                </ul>
            </div>
            <div style="flex: 1; min-width: 200px; margin-bottom: 20px;">
                <h4 style="font-weight: 300; margin-bottom: 10px;">Đăng Ký Nhận Tin</h4>
                <form action="@Url.Action("Subscribe", "Newsletter")" method="post">
                    <input type="email" name="email" placeholder="Nhập email của bạn" style="padding: 8px; width: 70%; border: 1px solid #333; border-radius: 4px;" required>
                    <button type="submit" style="padding: 8px; background-color: #333; color: #fff; border: none; border-radius: 4px;">Đăng Ký</button>
                </form>
            </div>
        </div>
        <div style="text-align: center; padding: 10px 0; border-top: 1px solid #ddd; margin-top: 20px;">
            <p style="margin: 0;">© @DateTime.Now.Year NgocHiepCeilingFans. All rights reserved.</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
