@model List<NgocHiepCeilingFans.Models.DonHang>

@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    
}


<link rel="stylesheet" href="~/css/san-pham.css" />
<h2>Quản Lý Đơn Hàng</h2>
<style>
    .btn-transparent {
        background-color: transparent;
        color: #6a6a6a;
        font-family: 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        border-radius: 4px;
        transition: all 0.2s ease-in-out;
    }

        .btn-transparent:hover {
            background-color: rgba(0, 0, 0, 0.05);
            text-decoration: underline;
            border-color: #000;
            color: #000;
            cursor: pointer;
        }

</style>
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}
@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Mã Đơn Hàng</th>
                <th>Người Đặt</th>
                <th>SĐT</th>
                <th>Ngày Đặt</th>
                <th>Tổng Tiền</th>
                <th>Trạng Thái</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var donHang in Model)
            {
                <tr>
                    <td>@donHang.Id</td>
                    <td>@donHang.HoTen</td>
                    <td>@donHang.SoDienThoai</td>
                    <td>@donHang.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@donHang.TongTien.ToString("N0") VNĐ</td>
                    <td>@donHang.TrangThai</td>
                    <td>
                        <a asp-area="Admin" asp-controller="DonHang" asp-action="ChiTietDonHang" asp-route-id="@donHang.Id"
                           class="btn btn-sm btn-transparent">
                            Xem
                        </a>

                        <a asp-area="Admin" asp-controller="DonHang" asp-action="SuaTrangThai" asp-route-id="@donHang.Id"
                           class="btn btn-sm btn-transparent">
                            Sửa Trạng Thái
                        </a>

                        <form asp-area="Admin" asp-controller="DonHang" asp-action="Xoa" method="post" style="display:inline-block;">
                            <input type="hidden" name="id" value="@donHang.Id" />
                            <button type="submit"
                                    class="btn btn-sm btn-transparent"
                                    onclick="return confirm('Bạn có chắc chắn muốn xóa đơn hàng này không? (Hành động này có thể không khôi phục được)');">
                                Xóa
                            </button>
                        </form>


                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Không có đơn hàng nào.</p>
}